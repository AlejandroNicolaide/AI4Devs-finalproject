DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/asistenteia
SECRET_KEY=change-me-to-a-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Orígenes CORS permitidos, separados por comas (en producción: URL pública del frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Similitud coseno mínima (0-1) para citar un fragmento; vacío = sin filtro
SIMILARITY_THRESHOLD=
